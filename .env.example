# Copy to .env.local for development. Never commit real values.
# Documented in docs/EMAIL_SETUP.md and README.md.

# Canonical site origin (no trailing slash). Confirm apex vs www before launch.
NEXT_PUBLIC_SITE_URL=https://syntaxflowllc.com

# Inquiry delivery: "emailjs" in deployed environments. "log" is for development only.
# Unset in production means the form refuses submissions (HTTP 503) instead of losing them.
INQUIRY_DELIVERY=

# EmailJS (server-side only; none of these reach the browser).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
# Optional separate template for talent network sign-ups.
EMAILJS_TEMPLATE_ID_CANDIDATE=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional: submissions allowed per client per 10 minutes (default 5).
INQUIRY_RATE_LIMIT_MAX=

# Set to "false" on preview/staging so search engines are told not to index.
SITE_INDEXABLE=

# E2E_TEST_MODE=1 lets "log" delivery run under `next start`. Test runs only. Never set on a deployment.
